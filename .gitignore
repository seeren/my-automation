# Ignore accidental local secrets files (secrets belong in host env)
env.sh
*.env
node_modules/
vars/logs/*.log
vars/pids/*
!vars/pids/.gitkeep
vars/active
vars/commands/*
!vars/commands/.gitkeep
vars/status/*
!vars/status/.gitkeep
vars/sessions/*
!vars/sessions/.gitkeep
vars/audios/*.opus
vars/audios/*.wav
vars/transcripts/*.txt
vars/transcripts/*.md
vars/*.bin
vars/*.json

