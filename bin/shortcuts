#!/usr/bin/env bash

# @describe Run a Shortcuts workflow

ROOT="$(dirname "$0")/.."

# shellcheck source=/dev/null
source "$ROOT/config.sh"

SRC="$ROOT/src"

# shellcheck source=/dev/null
source "$SRC/dispatcher.sh"
# shellcheck source=/dev/null
source "$SRC/controllers/meeting_record.sh"
# shellcheck source=/dev/null
source "$SRC/controllers/meeting_stop.sh"
# shellcheck source=/dev/null
source "$SRC/controllers/inbox_add.sh"
unset ROOT SRC

# @cmd Start or reuse a Discord meeting recording
meeting_record() {
  dispatch meeting_record_controller
}

# @cmd Stop the current Discord meeting
meeting_stop() {
  dispatch meeting_stop_controller
}

# @cmd Add an item to the ClickUp inbox
# @arg title! <TITLE> Inbox item title
# @option --priority <PRIORITY> Inbox item priority
inbox_add() {
  dispatch inbox_add_controller "${argc_title-}" "${argc_priority-}"
}

eval "$(argc --argc-eval "$0" "$@")"
